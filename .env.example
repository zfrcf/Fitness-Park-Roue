# ───────────── Accès privé ─────────────
# Mot de passe de connexion (une seule personne). Choisissez une valeur longue.
APP_PASSWORD=
# Secret aléatoire (32+ caractères) servant à signer le cookie de session.
SESSION_SECRET=

# ───────────── Fournisseurs (compatibles OpenAI) ─────────────
# Déclarez autant de fournisseurs que vous voulez : PROVIDER_1_*, PROVIDER_2_*, …
# Ils sont détectés automatiquement, dans l'ordre des numéros.
# CONTEXT = taille de la fenêtre de contexte du modèle, en tokens.
PROVIDER_1_NAME=Groq
PROVIDER_1_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_1_API_KEY=
PROVIDER_1_MODEL=qwen/qwen3.8-27b
# Requêtes par minute autorisées (facultatif ; NVIDIA 40, Groq 30, OpenRouter 20, Cloudflare 300 par défaut)
# PROVIDER_1_RPM=40
PROVIDER_1_CONTEXT=131072

PROVIDER_2_NAME=Cloudflare
PROVIDER_2_BASE_URL=https://api.cloudflare.com/client/v4/accounts/VOTRE_ACCOUNT_ID/ai/v1
PROVIDER_2_API_KEY=
PROVIDER_2_MODEL=@cf/qwen/qwen3.8-27b
PROVIDER_2_CONTEXT=262144

PROVIDER_3_NAME=OpenRouter
PROVIDER_3_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_3_API_KEY=
PROVIDER_3_MODEL=qwen/qwen3.8-27b:free
PROVIDER_3_CONTEXT=262144

# Fournisseur payant optionnel (dernier rang) : utilisé seulement si tous les
# gratuits sont épuisés. Mettez PROVIDER_n_PAID=true et un plafond mensuel en USD.
# PROVIDER_4_NAME=OpenRouter (payant)
# PROVIDER_4_BASE_URL=https://openrouter.ai/api/v1
# PROVIDER_4_API_KEY=
# PROVIDER_4_MODEL=qwen/qwen3.8-27b
# PROVIDER_4_CONTEXT=262144
# PROVIDER_4_PAID=true
# Prix en USD par million de tokens, pour estimer la dépense si l'API ne la renvoie pas
# (OpenRouter la renvoie ; inutile dans ce cas).
# PROVIDER_4_PRICE_INPUT=0.45
# PROVIDER_4_PRICE_OUTPUT=3.20
# Plafond de dépense mensuel en USD, tous fournisseurs payants confondus. 0 = jamais de payant.
PAID_MONTHLY_CAP=0

# ───────────── Stockage ─────────────
# Postgres (Neon via le Marketplace Vercel). Sans valeur : base locale PGlite dans ./data
DATABASE_URL=
# Redis (Upstash via le Marketplace Vercel). Sans valeur : mémoire du processus.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────── Divers ─────────────
# Fuseau horaire d'affichage (défaut : Europe/Paris).
APP_TZ=Europe/Paris
# URL publique de l'application (envoyée à OpenRouter dans l'en-tête HTTP-Referer).
APP_URL=http://localhost:3000

# ───────────── Recherche web ─────────────
# Sans clé : Bing puis DuckDuckGo (pages HTML) puis Wikipédia. Clés facultatives, essayées en premier :
# Brave (2 000 requêtes/mois gratuites), Tavily (1 000/mois), Jina (JINA_API_KEY ci-dessous).
BRAVE_API_KEY=
TAVILY_API_KEY=

# ───────────── Compilation sur GitHub (mods Minecraft, projets Gradle) ─────────────
# Dépôt où les projets sont poussés (branche compilation/<id>) et compilés par GitHub Actions.
# Idéalement un dépôt dédié à la compilation, NON relié à Vercel (sinon déploiements preview en échec).
GITHUB_REPO=zfrcf/Fitness-Park-Roue
# Jeton d'accès fin (fine-grained) limité à ce dépôt : Contents (lecture/écriture), Actions (lecture/écriture), Metadata.
GITHUB_TOKEN=

# ───────────── Lecture de liens ─────────────
# Clé Jina Reader optionnelle (sans clé : 20 requêtes/min, avec : 500/min).
JINA_API_KEY=

# --- Tâches de fond (facultatif) ---
# Par défaut, chaque tranche de travail relance la suivante elle-même et un workflow GitHub
# (.github/workflows/reveil.yml) réveille les tâches en attente toutes les 10 minutes.
# Avec un jeton QStash (Upstash, gratuit), les relances passent par QStash : plus robuste.
QSTASH_TOKEN=
